# Generated by XcodeGen — regenerate with `xcodegen generate`
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
DerivedData/
build/
.build/
.swiftpm/
*.xcuserstate
xcuserdata/

# Local, per-machine, never committed
FunctionAlps/Config/Local.xcconfig
FunctionAlps/Config/Secrets.xcconfig
.env
.env.*

# Apple credentials — NEVER commit (PRD §36)
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
fastlane/*.json
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# macOS
.DS_Store
