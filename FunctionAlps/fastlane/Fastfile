default_platform(:ios)

BUNDLE_ID = ENV["FA_BUNDLE_ID"] || "com.functionalps.patient"
PROJECT = "FunctionAlps.xcodeproj"

platform :ios do
  desc "Build, sign with match and upload to TestFlight. Runs on CI; no Mac required locally."
  lane :beta do
    setup_ci # temporary keychain on the runner

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    # First run creates the Apple Distribution certificate + App Store profile
    # through the API key and stores them in the certificates repo; later runs reuse.
    # fastlane forces readonly on CI by default; the first run must be allowed to
    # create the certificate + profile, later runs simply reuse what is in the repo.
    match(type: "appstore", api_key: api_key, app_identifier: [BUNDLE_ID], readonly: false, force: true) # force: profile picks up capability changes (Sign in with Apple)

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["FunctionAlps"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: ENV.fetch("sigh_#{BUNDLE_ID}_appstore_profile-name")
    )

    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID, initial_build_number: 0)
    rescue => e
      UI.important("Could not read the latest TestFlight build number (#{e.message}); starting at 0")
      0
    end
    increment_build_number(build_number: latest + 1, xcodeproj: PROJECT)

    build_app(
      project: PROJECT,
      scheme: "FunctionAlps",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "-skipMacroValidation"
    )

    # Members are EXTERNAL testers: a build reaches them only once it is added to their group. Until
    # 2026-09-28 this lane uploaded and stopped there, so builds 36–43 never left the internal team while
    # members stayed on 35. Distribution needs the PROCESSED build, hence no skip_waiting here.
    # Older builds are NOT expired automatically: if Beta App Review holds a build, expiring the one
    # members have would leave them nothing to open. Expire them in App Store Connect once this one is live.
    # FA_TESTFLIGHT_INTERNAL_ONLY=1 (the workflow's `internal_only` input): upload and stop. The build goes only
    # to the App Store Connect team's internal testers (their group gets new builds automatically); it is not
    # added to the external group, so members stay on the build they have. No wait for processing either —
    # there is nothing to distribute afterwards, and waiting would only burn macOS minutes.
    internal_only = ENV["FA_TESTFLIGHT_INTERNAL_ONLY"] == "1"
    UI.important("Internal testers only: not distributing to external testers") if internal_only

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      changelog: "FunctionAlps native iOS — build #{latest + 1} (#{ENV['GITHUB_SHA'].to_s[0, 7]})#{internal_only ? ' — internal only' : ''}",
      skip_waiting_for_build_processing: internal_only,
      wait_processing_timeout_duration: 2400,
      distribute_external: !internal_only,
      groups: internal_only ? nil : [ENV.fetch("FA_TESTFLIGHT_GROUP", "BetaTesters")],
      notify_external_testers: !internal_only,
      uses_non_exempt_encryption: false
    )
  end
end
