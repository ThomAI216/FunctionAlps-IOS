default_platform(:ios)

BUNDLE_ID = ENV["FA_BUNDLE_ID"] || "com.functionalps.patient"
PROJECT = "FunctionAlps.xcodeproj"

platform :ios do
  desc "Build, sign with match and upload to TestFlight. Runs on CI; no Mac required locally."
  lane :beta do
    setup_ci # temporary keychain on the runner

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    # First run creates the Apple Distribution certificate + App Store profile
    # through the API key and stores them in the certificates repo; later runs reuse.
    # fastlane forces readonly on CI by default; the first run must be allowed to
    # create the certificate + profile, later runs simply reuse what is in the repo.
    match(type: "appstore", api_key: api_key, app_identifier: [BUNDLE_ID], readonly: false, force: true) # force: profile picks up capability changes (Sign in with Apple)

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["FunctionAlps"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: ENV.fetch("sigh_#{BUNDLE_ID}_appstore_profile-name")
    )

    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID, initial_build_number: 0)
    rescue => e
      UI.important("Could not read the latest TestFlight build number (#{e.message}); starting at 0")
      0
    end
    increment_build_number(build_number: latest + 1, xcodeproj: PROJECT)

    build_app(
      project: PROJECT,
      scheme: "FunctionAlps",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "-skipMacroValidation"
    )

    # INTERNAL TESTERS ONLY by default (owner, 2026-10-06: "next time you ship to TestFlight, it will be
    # only for internal testers, not external beta testers"). Internal testers get every processed build
    # automatically; the external group (members, "BetaTesters") is reached only when a run sets
    # FA_TESTFLIGHT_EXTERNAL=true on purpose — never by default.
    # History: members are EXTERNAL testers, reached once a build is added to their group (builds 36–43 never
    # left the internal team while members stayed on 35, until 2026-09-28). Older builds are NOT expired
    # automatically: if Beta App Review holds a build, expiring the one members have leaves them nothing.
    external = ENV["FA_TESTFLIGHT_EXTERNAL"] == "true"
    UI.message(external ? "TestFlight: internal team AND external group #{ENV.fetch('FA_TESTFLIGHT_GROUP', 'BetaTesters')}" : "TestFlight: internal testers only")
    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      changelog: "FunctionAlps native iOS — build #{latest + 1} (#{ENV['GITHUB_SHA'].to_s[0, 7]})",
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 2400,
      distribute_external: external,
      groups: external ? [ENV.fetch("FA_TESTFLIGHT_GROUP", "BetaTesters")] : nil,
      notify_external_testers: external,
      uses_non_exempt_encryption: false
    )
  end
end
