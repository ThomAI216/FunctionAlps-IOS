    "consents.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Terms are an agreement, not a consent, so there is nothing here to withdraw. If you no longer accept them, stop using the app and delete your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Conditions sont un accord et non un consentement : il n’y a donc rien à retirer ici. Si vous ne les acceptez plus, cessez d’utiliser l’application et supprimez votre compte."
          }
        }
      }
    },
