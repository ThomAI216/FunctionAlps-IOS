    },
    "tip.night_tea.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A warm, caffeine-free tea can settle the nervous system before sleep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tisane chaude et sans caféine peut apaiser le système nerveux avant de s'endormir."
          }
        }
      }
    },
    "tip.pm_coffee.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip coffee after 2pm today and let tonight’s sleep reward you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez de boire du café après 14 h aujourd'hui et vous verrez que vous en serez récompensé(e) ce soir, au moment de vous coucher."
          }
        }
      }
    },
    "tip.pm_coffee.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeine lingers 6+ hours · a late coffee quietly frays tonight’s sleep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caféine reste active pendant plus de 6 heures · un café pris tardivement vient discrètement perturber le sommeil de cette nuit."
          }
        }
      }
    },
    "tip.pm_fibre.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an extra handful of veg to lunch today and feed a calmer gut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une poignée supplémentaire de légumes à votre déjeuner aujourd’hui pour favoriser un meilleur équilibre intestinal."
          }
        }
      }
    },
    "tip.pm_fibre.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a handful of fibre-rich veg · your gut bugs turn it into anti-inflammatory fuel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une poignée de légumes riches en fibres : vos bactéries intestinales les transforment en énergie anti-inflammatoire."
          }
        }
      }
    },
    "tip.pm_plate.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build your next plate this way and feel full without the heaviness."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Composez votre prochain repas de cette manière et vous vous sentirez rassasié(e) sans avoir l'impression d'avoir l'estomac lourd."
          }
        }
      }
    },
    "tip.pm_plate.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build lunch around a palm of protein, a fist of veg, a thumb of healthy fat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Composez votre déjeuner en prévoyant une paume de protéines, un poing de légumes et un pouce de matières grasses saines."
          }
        }
      }
    },
    "tip.pm_walk.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk for 10 minutes after this meal and blunt the post-lunch slump."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez pendant 10 minutes après ce repas pour éviter le coup de barre de l'après-déjeuner."
          }
        }
      }
    },
    "tip.pm_walk.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 10-minute walk after eating blunts the glucose rise and eases digestion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une promenade de 10 minutes après le repas atténue la hausse de glycémie et facilite la digestion."
          }
        }
      }
    },
