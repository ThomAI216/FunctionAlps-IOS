        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autres appareils"
          }
        }
      }
    },
    "wearables.others.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These link through the FunctionAlps web app for now. Once linked there, their data shows up here too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces appareils se connectent via l’application web FunctionAlps pour l’instant. Une fois liés, leurs données apparaissent ici aussi."
          }
        }
      }
    },
    "wearables.others.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin, Oura, Fitbit, Withings, Strava, Polar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin, Oura, Fitbit, Withings, Strava, Polar"
