    "nutrient.ala.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha-linolenic acid is the plant form of Omega-3. The body can convert it to EPA/DHA, but inefficiently. Still valuable for overall Omega-3 ratio improvement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acide alpha-linolénique est la forme végétale des oméga-3. L'organisme est capable de le transformer en EPA/DHA, mais de manière peu efficace. Il reste néanmoins utile pour améliorer globalement le rapport en oméga-3."
          }
        }
      }
    },
