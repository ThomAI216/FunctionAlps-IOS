      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone isn't allowed. You can enable it in Settings, or type your meal below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro n’est pas autorisé. Activez-le dans Réglages, ou écrivez votre repas ci-dessous."
          }
        }
      }
    },
    "food.voice.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice isn't available right now · type your meal below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix n’est pas disponible pour le moment · écrivez votre repas ci-dessous."
          }
        }
      }
    },
    "food.when.today": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "today · %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "aujourd’hui · %@"
          }
        }
      }
    },
    "food.when.yesterday": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yesterday · %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "hier · %@"
          }
        }
      }
    },
    "guide.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every screen explained in plain language. Read the first three and you will understand the whole thing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écran expliqué en langage simple. Lisez les trois premiers et vous aurez tout compris."
          }
        }
      }
    },
    "guide.notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That page of the guide could not be found. Head back and pick another."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page du guide est introuvable. Revenez en arrière et choisissez-en une autre."
          }
        }
      }
    },
    "guide.openScreen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this screen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir cet écran"
          }
        }
      }
    },
    "guide.startHere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start here"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez ici"
          }
        }
      }
    },
    "guide.stillStuck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still stuck? Help & FAQ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours bloqué·e ? Aide et FAQ"
          }
        }
      }
    },
    "guide.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide"
          }
        }
      }
    },
    "help.checkins.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen holds both daily check-ins and shows how they have been going. Each card is a summary and a door at the same time · tap one to do that check-in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran regroupe les deux bilans quotidiens et montre leur évolution. Chaque carte est à la fois un résumé et une porte · touchez-en une pour faire ce bilan."
          }
        }
      }
    },
    "help.checkins.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can come back and edit today’s answers · saving again just updates them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez revenir modifier les réponses du jour · enregistrer à nouveau les met simplement à jour."
          }
        }
      }
    },
    "help.checkins.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "two short sets of questions, once a day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "deux courtes séries de questions, une fois par jour"
          }
        }
      }
    },
    "help.checkins.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide each one to roughly where you are, tap what fits. One minute, no right answer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez chaque curseur à peu près là où vous en êtes, touchez ce qui correspond. Une minute, pas de bonne réponse."
          }
        }
      }
    },
    "help.checkins.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How you actually felt · energy, sleep, mood, digestion. The one thing no device can report for you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez réellement ressenti · énergie, sommeil, humeur, digestion. La seule chose qu’aucun appareil ne peut rapporter à votre place."
          }
        }
      }
    },
    "help.checkins.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These carry more weight in your scores than any device. They are how the app learns what normal feels like for you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réponses pèsent plus dans vos scores que n’importe quel appareil. C’est ainsi que l’application apprend ce qui est normal pour vous."
          }
        }
      }
    },
    "help.checkins.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your check-ins"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos bilans"
          }
        }
      }
    },
    "help.confirm.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here is what the app thinks you ate. It has already been saved to your day, so nothing is lost if you close this. Look it over and fix anything that is off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici ce que l’application pense que vous avez mangé. C’est déjà enregistré dans votre journée, rien n’est perdu si vous fermez. Relisez et corrigez ce qui ne va pas."
          }
        }
      }
    },
    "help.confirm.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an estimate, not a lab measurement. Close enough is close enough."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une estimation, pas une mesure de laboratoire. À peu près, c’est suffisant."
          }
        }
      }
    },
    "help.confirm.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the app’s best guess · your call"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la meilleure estimation de l’application · à vous de voir"
          }
        }
      }
    },
    "help.confirm.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look it over, fix anything that’s off. It’s already saved · nothing is lost if you close."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relisez, corrigez ce qui ne va pas. C’est déjà enregistré · rien n’est perdu si vous fermez."
          }
        }
      }
    },
    "help.confirm.p2.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The little symbols"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les petits symboles"
          }
        }
      }
    },
    "help.confirm.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick read on each food · fibre, added sugar and friends. Tap one to see what it means."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aperçu rapide de chaque aliment · fibres, sucres ajoutés et compagnie. Touchez-en un pour savoir ce qu’il signifie."
          }
        }
      }
    },
    "help.confirm.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every correction teaches the app your foods · next time it gets them right on its own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque correction apprend vos aliments à l’application · la prochaine fois, elle les reconnaît seule."
          }
        }
      }
    },
    "help.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the meal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier le repas"
          }
        }
      }
    },
    "help.felt.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blood test tells you where you were on one particular morning. A watch tells you what your body did while you slept. Both are useful. Neither one knows how you actually felt on Tuesday · and that is usually the thing that tells you whether something is working."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse de sang dit où vous en étiez un matin donné. Une montre dit ce que votre corps a fait pendant votre sommeil. Les deux sont utiles. Aucune ne sait comment vous vous sentiez vraiment mardi · et c’est souvent ce qui dit si quelque chose fonctionne."
          }
        }
      }
    },
    "help.felt.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is why your own check-ins carry more weight in your scores than any device does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est pourquoi vos propres bilans pèsent plus dans vos scores que n’importe quel appareil."
          }
        }
      }
    },
    "help.felt.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "why we ask how you feel, not just what your watch says"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pourquoi nous demandons comment vous vous sentez, pas seulement ce que dit votre montre"
          }
        }
      }
    },
    "help.felt.p1.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How you feel is real information"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous ressentez est une vraie information"
          }
        }
      }
    },
    "help.felt.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy, digestion, mood, sleep. You are the only one who can report these, and they shift long before a lab marker does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Énergie, digestion, humeur, sommeil. Vous seul·e pouvez les rapporter, et ils bougent bien avant un marqueur de laboratoire."
          }
        }
      }
    },
    "help.felt.p2.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The point is noticing the link"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’important, c’est de voir le lien"
          }
        }
      }
    },
    "help.felt.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late dinner, rough sleep. Skipped the walk, flat afternoon. The app lines these up so the pattern shows itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dîner tardif, nuit agitée. Marche sautée, après-midi plat. L’application aligne tout cela pour que le schéma apparaisse."
          }
        }
      }
    },
    "help.felt.p3.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Together they beat either alone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensemble, ils valent plus que chacun seul"
          }
        }
      }
    },
    "help.felt.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your watch says you slept fine and you felt wrecked, that gap is the interesting part. It is not an error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand votre montre dit que vous avez bien dormi et que vous vous sentez épuisé·e, cet écart est ce qui est intéressant. Ce n’est pas une erreur."
          }
        }
      }
    },
    "help.felt.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body keeps a record your bloods don’t"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps garde une trace que vos analyses n’ont pas"
          }
        }
      }
    },
    "help.food.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a meal here and the app works out roughly what was in it. You do not need to weigh anything or look up numbers · a photo is enough, and you can correct it afterwards."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un repas ici et l’application estime ce qu’il contenait. Rien à peser, rien à chercher · une photo suffit, et vous pouvez corriger ensuite."
          }
        }
      }
    },
    "help.food.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rough is fine. An approximate meal logged beats a perfect one skipped."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximatif, c’est bien. Un repas approximatif enregistré vaut mieux qu’un repas parfait oublié."
          }
        }
      }
    },
    "help.food.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "what a finished read looks like"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "à quoi ressemble une lecture terminée"
          }
        }
      }
    },
    "help.food.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The foods on your plate and roughly how much of each. Shoot from above, whole plate in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aliments dans votre assiette et, à peu près, la quantité de chacun. Photographiez d’en haut, l’assiette entière."
          }
        }
      }
    },
    "help.food.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each food becomes calories, protein, carbs and fat · your day’s totals update on their own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque aliment devient calories, protéines, glucides et lipides · vos totaux du jour se mettent à jour seuls."
          }
        }
      }
    },
    "help.food.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meals and your check-ins side by side is how the meals that don’t agree with you show themselves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos repas et vos bilans côte à côte, c’est ainsi que les repas qui ne vous conviennent pas se révèlent."
          }
        }
      }
    },
    "help.food.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading your plate"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire votre assiette"
          }
        }
      }
    },
    "help.group.around": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Around the app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autour de l’application"
          }
        }
      }
    },
    "help.group.around.blurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home, Trends, Food and Library · what each one is for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accueil, Tendances, Alimentation et Bibliothèque · à quoi sert chacun."
          }
        }
      }
    },
    "help.group.checkins": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily check-ins"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos bilans quotidiens"
          }
        }
      }
    },
    "help.group.checkins.blurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two-minute habit everything else is built on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’habitude de deux minutes sur laquelle tout le reste repose."
          }
        }
      }
    },
    "help.group.food": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging your food"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer vos repas"
          }
        }
      }
    },
    "help.group.food.blurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo to plate to pattern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De la photo à l’assiette, puis au schéma."
          }
        }
      }
    },
    "help.group.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start here"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez ici"
          }
        }
      }
    },
    "help.group.start.blurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this app is, and why the small stuff matters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’est cette application, et pourquoi les petits détails comptent."
          }
        }
      }
    },
    "help.home.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first thing you see. It is a summary rather than a to-do list · the big number tells you roughly where you are, and everything under it is a shortcut to whatever you would want next."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première chose que vous voyez. Un résumé plutôt qu’une liste de tâches · le grand chiffre dit à peu près où vous en êtes, et tout ce qui est en dessous est un raccourci vers la suite."
          }
        }
      }
    },
    "help.home.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashes just mean nothing is logged yet. It fills in as you go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tirets signifient simplement que rien n’est encore enregistré. Ça se remplit au fil du temps."
          }
        }
      }
    },
    "help.home.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "your day, at a glance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "votre journée, en un coup d’œil"
          }
        }
      }
    },
    "help.home.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick today’s actions as you go · they build your day’s picture too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les actions du jour au fur et à mesure · elles construisent aussi le tableau de votre journée."
          }
        }
      }
    },
    "help.home.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The small daily things you and your practitioner agreed on, and the score they feed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les petites choses du quotidien convenues avec votre praticienne, et le score qu’elles alimentent."
          }
        }
      }
    },
    "help.home.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doing beats reading · today’s two or three actions come before any number."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agir vaut mieux que lire · les deux ou trois actions du jour passent avant n’importe quel chiffre."
          }
        }
      }
    },
    "help.home.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accueil"
          }
        }
      }
    },
    "help.library.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two things live here: the reports the app writes from what you have logged, and material to read. The reading is chosen for your situation rather than for everyone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux choses vivent ici : les rapports que l’application écrit à partir de ce que vous avez enregistré, et des lectures. Les lectures sont choisies pour votre situation, pas pour tout le monde."
          }
        }
      }
    },
    "help.library.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "your reports and your reading"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vos rapports et vos lectures"
          }
        }
      }
    },
    "help.library.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the card at the top for your reports; browse the rest when you’re curious."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la carte du haut pour vos rapports ; parcourez le reste quand vous êtes curieux·se."
          }
        }
      }
    },
    "help.library.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write-ups built from what you logged, and reading your practitioner picked for your situation · not for everyone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des synthèses construites à partir de ce que vous avez enregistré, et des lectures choisies par votre praticienne pour votre situation · pas pour tout le monde."
          }
        }
      }
    },
    "help.library.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catch up on a week you weren’t paying attention to, in two minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rattrapez en deux minutes une semaine à laquelle vous n’avez pas prêté attention."
          }
        }
      }
    },
    "help.library.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothèque"
          }
        }
      }
    },
    "help.noResults": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No results for \"%@\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun résultat pour « %@ »"
          }
        }
      }
    },
    "help.overview.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is where your everyday life and your practitioner’s work meet. You log a few simple things · how you feel, and what you ate. The app turns that into a picture the two of you can look at together, so your appointments start from what actually happened rather than from what you can remember."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est là que votre vie quotidienne et le travail de votre praticienne se rejoignent. Vous notez quelques choses simples · comment vous vous sentez, et ce que vous avez mangé. L’application en fait une image que vous pouvez regarder ensemble, pour que vos rendez-vous partent de ce qui s’est vraiment passé plutôt que de vos souvenirs."
          }
        }
      }
    },
    "help.overview.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If something about your health worries you, message your practitioner rather than waiting for a number to change."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelque chose vous inquiète dans votre santé, écrivez à votre praticienne plutôt que d’attendre qu’un chiffre change."
          }
        }
      }
    },
    "help.overview.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the short version"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la version courte"
          }
        }
      }
    },
    "help.overview.p1.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you do"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous faites"
          }
        }
      }
    },
    "help.overview.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A thirty-second check-in most days, and a photo of your meals when you can manage it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bilan de trente secondes la plupart des jours, et une photo de vos repas quand vous le pouvez."
          }
        }
      }
    },
    "help.overview.p2.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you get back"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous obtenez"
          }
        }
      }
    },
    "help.overview.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores that show which way things are heading, and short reports that pull a week together."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des scores qui montrent dans quel sens vont les choses, et de courts rapports qui résument une semaine."
          }
        }
      }
    },
    "help.overview.p3.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your practitioner sees"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que voit votre praticienne"
          }
        }
      }
    },
    "help.overview.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same picture you do · so they arrive at your call already up to speed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même image que vous · elle arrive à votre consultation déjà au courant."
          }
        }
      }
    },
    "help.overview.p4.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it is not"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que ce n’est pas"
          }
        }
      }
    },
    "help.overview.p4.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not diagnose anything, and it does not replace your practitioner. It is the record you build between visits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne diagnostique rien et ne remplace pas votre praticienne. C’est le carnet que vous construisez entre deux visites."
          }
        }
      }
    },
    "help.overview.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this app is for"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi sert cette application"
          }
        }
      }
    },
    "help.point.howItHelps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it helps you"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En quoi cela vous aide"
          }
        }
      }
    },
    "help.point.howWeUseIt": {
