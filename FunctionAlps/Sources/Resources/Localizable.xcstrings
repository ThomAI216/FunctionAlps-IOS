    "wearables.read.activity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps, distance, active energy, exercise minutes and workouts"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas, distance, énergie active, minutes d’exercice et entraînements"
          }
        }
      }
    },
    "wearables.read.breath": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathing rate, blood oxygen, VO₂ max and weight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence respiratoire, oxygène sanguin, VO₂ max et poids"
          }
        }
      }
    },
    "wearables.read.heart": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate, resting heart rate, heart-rate variability (SDNN)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence cardiaque, fréquence au repos, variabilité cardiaque (SDNN)"
          }
        }
      }
    },
    "wearables.read.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only. Nothing is written back to Health, and you can turn any type off in Settings → Health → Data Access & Devices → FunctionAlps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule. Rien n’est écrit dans Santé, et vous pouvez désactiver chaque type dans Réglages → Santé → Accès aux données et appareils → FunctionAlps."
          }
        }
      }
    },
    "wearables.read.sleep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep: in bed, asleep, deep, REM, awake and interruptions"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommeil : au lit, endormi·e, profond, paradoxal, éveil et interruptions"
