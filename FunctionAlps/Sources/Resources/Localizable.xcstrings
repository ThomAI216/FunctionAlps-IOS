    "privacy.banner.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FunctionAlps is based in Switzerland and complies with the Federal Act on Data Protection (nFADP, revised 2023) and GDPR. Your health data never leaves Swiss or EU-compliant servers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FunctionAlps est basée en Suisse et respecte la loi fédérale sur la protection des données (nLPD, révisée en 2023) et le RGPD. Vos données de santé ne quittent jamais des serveurs suisses ou conformes au droit européen."
          }
        }
      }
    },
    "privacy.banner.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiss Data Protection (nFADP)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection des données en Suisse (nLPD)"
          }
        }
      }
    },
    "privacy.collect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What we collect & why"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que nous collectons et pourquoi"
          }
        }
      }
    },
    "privacy.collect.ai.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is sent · de-identified, with your name never attached · to Infomaniak's Swiss AI for analysis. It produces observations, not medical advice or diagnosis. AI is required for the app to work · you can manage your consent below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont envoyées · dé-identifiées, jamais accompagnées de votre nom · à l’IA suisse d’Infomaniak pour analyse. Elle produit des observations, pas un avis médical ni un diagnostic. L’IA est nécessaire au fonctionnement de l’application · vous pouvez gérer votre consentement ci-dessous."
          }
        }
      }
    },
    "privacy.collect.ai.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI analysis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse par IA"
          }
        }
      }
    },
    "privacy.collect.health.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meals, check-ins and the symptoms you log. Used only to mirror how your body responds to food · observations, never medical advice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repas, bilans et symptômes que vous notez. Utilisés uniquement pour refléter la façon dont votre corps réagit à l’alimentation · des observations, jamais un avis médical."
          }
        }
      }
    },
    "privacy.collect.health.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health & nutrition data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de santé et de nutrition"
          }
        }
      }
    },
    "privacy.collect.storage.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is stored encrypted on Supabase (EU data centre). You can request deletion at any time · all your data is erased within 30 days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont stockées chiffrées sur Supabase (centre de données européen). Vous pouvez demander leur suppression à tout moment · tout est effacé sous 30 jours."
          }
        }
      }
    },
    "privacy.collect.storage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage"
          }
        }
      }
    },
    "privacy.collect.who.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis is de-identified · your name is never attached. A wellness reviewer may see anonymised flags; your identity is revealed only with your explicit consent, and every access is logged. Never shared with advertisers or insurers. Ever."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse est dé-identifiée · votre nom n’est jamais attaché. Un·e relecteur·rice bien-être peut voir des signaux anonymisés ; votre identité n’est révélée qu’avec votre consentement explicite, et chaque accès est journalisé. Jamais partagé avec des annonceurs ou des assureurs. Jamais."
          }
        }
      }
    },
