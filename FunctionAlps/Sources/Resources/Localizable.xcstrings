    "nutrient.dha.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docosahexaenoic acid (DHA) is the most abundant omega-3 in brain tissue and retinal membranes. It is critical for cognitive function, visual acuity, and neuronal signalling. DHA needs increase during pregnancy and early childhood."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acide docosahexaénoïque (DHA) est l'oméga-3 le plus abondant dans le tissu cérébral et les membranes rétiniennes. Il joue un rôle essentiel dans les fonctions cognitives, l'acuité visuelle et la transmission des signaux neuronaux. Les besoins en DHA augmentent pendant la grossesse et la petite enfance."
          }
        }
      }
    },
