    },
    "baseline.sex.helper": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to estimate your energy requirements."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
