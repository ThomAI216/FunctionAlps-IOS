    "macroEdu.protein.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build, repair, and protect"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construire, réparer et protéger"
          }
        }
      }
    },
    "macroEdu.protein.timing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread protein across all meals. Aim for 20-40g per meal. Post-workout is especially important."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartissez votre apport en protéines sur tous vos repas. Visez une quantité comprise entre 20 et 40 g par repas. L'apport après l'entraînement est particulièrement important."
          }
        }
      }
    },
    "macroEdu.protein.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protéines"
          }
        }
      }
    },
    "macroEdu.protein.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein is the building block of every cell in your body. We currently target 1.5g/kg/day for women and 1.8g/kg/day for men. It builds muscle, repairs tissue, supports hormones, and improves satiety."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les protéines constituent les éléments constitutifs de toutes les cellules de votre corps. Nous recommandons actuellement un apport de 1,5 g/kg/jour pour les femmes et de 1,8 g/kg/jour pour les hommes. Elles contribuent à la formation des muscles, à la réparation des tissus, au bon fonctionnement du système hormonal et à une meilleure sensation de satiété."
          }
        }
      }
    },
    "macros.a11y": {
