    "macroEdu.carbs.myth.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Myth: Carbs make you fat (excess calories do, not carbs specifically)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mythe : les glucides font grossir (ce sont les calories en excès qui font grossir, pas les glucides en particulier)"
          }
        }
      }
    },
    "macroEdu.carbs.myth.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Myth: You should eliminate carbs (brain needs glucose to function)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mythe : Il faudrait supprimer les glucides (le cerveau a besoin de glucose pour fonctionner)"
          }
        }
      }
    },
