    "verdict.digestion.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fibre-rich, with good plant variety."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riche en fibres, avec une bonne variété végétale."
          }
        }
      }
    },
    "verdict.digestion.low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little fibre or plant variety in this meal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de fibres ou de variété végétale dans ce repas."
          }
        }
      }
    },
    "verdict.digestion.mid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some fibre and plant variety · one more plant would lift it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu de fibres et de végétaux · un végétal de plus l'améliorerait."
          }
        }
      }
    },
    "verdict.glycemic.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbohydrate arrives largely with its fibre intact."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les glucides arrivent en grande partie avec leurs fibres."
          }
        }
      }
    },
    "verdict.glycemic.low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbohydrate here is mostly refined or sweetened."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les glucides sont surtout raffinés ou sucrés."
          }
        }
      }
    },
    "verdict.glycemic.mid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mix of intact and refined carbohydrate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mélange de glucides complets et raffinés."
          }
        }
      }
    },
    "verdict.inflammation.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat here comes mostly from whole-food sources."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les graisses viennent surtout d'aliments bruts."
          }
        }
      }
    },
    "verdict.inflammation.low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat here comes mostly from processed or refined sources."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les graisses viennent surtout de sources transformées ou raffinées."
          }
        }
      }
    },
    "verdict.inflammation.mid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mixed picture of fat sources."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sources de graisses mélangées."
