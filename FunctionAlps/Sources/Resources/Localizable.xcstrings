    "nutrient.biotin.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biotin is a B-vitamin cofactor in carboxylase enzymes involved in fatty acid synthesis, gluconeogenesis, and amino acid metabolism. Widely known for supporting hair, skin, and nail health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La biotine est un cofacteur de la famille des vitamines B présent dans les enzymes carboxylases impliquées dans la synthèse des acides gras, la gluconéogenèse et le métabolisme des acides aminés. Elle est largement reconnue pour contribuer à la santé des cheveux, de la peau et des ongles."
          }
        }
      }
    },
