        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very low fat. Risk of hormone disruption if sustained long-term."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très peu de lipides. Risque de perturbation hormonale si prolongé."
