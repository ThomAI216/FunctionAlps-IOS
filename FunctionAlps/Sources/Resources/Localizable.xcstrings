            "value": "Glucides élevés. Idéal pour l’endurance et la recharge du glycogène."
          }
        }
      }
    },
    "targets.ctx.carbs.keto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very low carbs · ketogenic range. May impair high-intensity exercise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très peu de glucides · zone cétogène. Peut gêner l’effort à haute intensité."
          }
        }
      }
    },
    "targets.ctx.carbs.low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low carbs. Fine for sedentary days, but may limit training performance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de glucides. Convient aux jours sédentaires, mais peut limiter la performance à l’entraînement."
          }
        }
      }
    },
    "targets.ctx.carbs.moderate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderate carbs. Balanced approach for most active adults."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucides modérés. Approche équilibrée pour la plupart des adultes actifs."
          }
        }
      }
    },
    "targets.ctx.fat.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High fat / low carb approach. Suits keto or insulin resistance protocols."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approche riche en lipides / pauvre en glucides. Convient aux protocoles cétogènes ou de résistance à l’insuline."
          }
        }
      }
    },
    "targets.ctx.fat.moderate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderate fat. Works well for higher carb approaches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipides modérés. Fonctionne bien avec une approche plus riche en glucides."
          }
        }
      }
    },
    "targets.ctx.fat.optimal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
