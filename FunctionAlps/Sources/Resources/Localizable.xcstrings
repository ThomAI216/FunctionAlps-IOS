    "nutrient.magnesium.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnesium is a cofactor in over 300 enzymatic reactions, including energy production, protein synthesis, muscle contraction, and nerve function. About 50% of people are deficient."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le magnésium est un cofacteur intervenant dans plus de 300 réactions enzymatiques, notamment la production d'énergie, la synthèse des protéines, la contraction musculaire et le fonctionnement du système nerveux. Environ 50 % de la population présente une carence en magnésium."
          }
        }
      }
    },
