    "faq.account.a1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact your FunctionAlps practitioner or email contact@functionalps.ch. Your baseline (age, height, weight, activity) can be updated from your profile in the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contactez votre praticienne FunctionAlps ou écrivez à contact@functionalps.ch. Votre point de départ (âge, taille, poids, activité) se modifie depuis votre profil dans l’application."
          }
        }
      }
    },
    "faq.account.a2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Go to Profile > Settings > Privacy & data > Export my data. You get a complete copy as JSON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. Allez dans Profil > Paramètres > Confidentialité et données > Exporter mes données. Vous obtenez une copie complète au format JSON."
          }
        }
      }
    },
    "faq.account.a3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Profile > Settings > Privacy & data > Delete my account. This permanently erases all your data within 30 days. This action cannot be undone. Your practitioner will be notified."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Profil > Paramètres > Confidentialité et données > Supprimer mon compte. Cela efface définitivement toutes vos données sous 30 jours. Cette action est irréversible. Votre praticienne en est informée."
          }
        }
      }
    },
    "faq.account.a4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. FunctionAlps is registered in Switzerland and your data is stored on EU-compliant servers. We comply with the Swiss Federal Act on Data Protection (nFADP) and GDPR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. FunctionAlps est enregistrée en Suisse et vos données sont hébergées sur des serveurs conformes au droit européen. Nous respectons la nLPD suisse et le RGPD."
          }
        }
      }
    },
    "faq.account.q1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I update my personal information?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment mettre à jour mes informations personnelles ?"
          }
        }
      }
    },
    "faq.account.q2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I export my data?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis-je exporter mes données ?"
          }
        }
      }
    },
    "faq.account.q3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I delete my account?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment supprimer mon compte ?"
          }
        }
      }
    },
    "faq.account.q4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is my data stored in Switzerland?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes données sont-elles stockées en Suisse ?"
          }
        }
      }
    },
    "faq.account.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account & data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte et données"
          }
        }
      }
    },
    "faq.app.a1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the Food tab at the bottom of the screen. You can take a photo of your meal to have it analysed automatically, or describe it by voice or in writing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’onglet Alimentation en bas de l’écran. Prenez une photo de votre repas pour qu’il soit analysé automatiquement, ou décrivez-le à la voix ou par écrit."
          }
        }
      }
    },
    "faq.app.a2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each morning you will see a check-in prompt on the Home tab. It takes about 30 seconds and tracks your energy, digestion, mood, and sleep quality. This data feeds directly into your progress graphs and helps your nutritionist adjust your plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque matin, un bilan vous est proposé sur l’onglet Accueil. Il prend environ 30 secondes et suit votre énergie, votre digestion, votre humeur et la qualité de votre sommeil. Ces réponses alimentent vos graphiques et aident votre nutritionniste à ajuster votre plan."
          }
        }
      }
    },
    "faq.app.a3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can browse most screens offline. Meal photo analysis and syncing require an internet connection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez parcourir la plupart des écrans hors ligne. L’analyse des photos de repas et la synchronisation nécessitent une connexion internet."
          }
        }
      }
    },
    "faq.app.q1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I log a meal?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment enregistrer un repas ?"
          }
        }
      }
    },
    "faq.app.q2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How does the daily check-in work?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment fonctionne le bilan quotidien ?"
          }
        }
      }
    },
    "faq.app.q3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I use the app offline?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis-je utiliser l’application hors ligne ?"
          }
        }
      }
    },
    "faq.app.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation de l’application"
          }
        }
      }
    },
    "faq.nutrition.a1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your targets are based on your weight, height, age, activity level, and health goals · adjusted for your goal (maintain, lose, gain, performance). Your nutritionist can override these at any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos cibles reposent sur votre poids, votre taille, votre âge, votre niveau d’activité et vos objectifs de santé · ajustées selon votre objectif (maintien, perte, prise, performance). Votre nutritionniste peut les modifier à tout moment."
          }
        }
      }
    },
    "faq.nutrition.a2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI meal analysis is an estimate, not a lab measurement. For packaged foods, try photographing the nutrition label directly for higher accuracy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse IA d’un repas est une estimation, pas une mesure de laboratoire. Pour les produits emballés, photographiez directement l’étiquette nutritionnelle pour plus de précision."
          }
        }
      }
    },
    "faq.nutrition.a3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The score (0-100) reflects how well your meal supports your specific health goals · it considers inflammation markers, energy quality, gut health, and digestibility. It is not a simple calorie or \"healthiness\" score."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le score (0-100) reflète à quel point votre repas soutient vos objectifs de santé · il tient compte des marqueurs inflammatoires, de la qualité énergétique, de la santé intestinale et de la digestibilité. Ce n’est pas un simple score de calories ou de « santé »."
          }
        }
      }
    },
    "faq.nutrition.a4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can scroll back through your log indefinitely. The progress charts show rolling 7-day and 30-day averages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez remonter votre journal sans limite. Les graphiques de progression montrent des moyennes glissantes sur 7 et 30 jours."
          }
        }
      }
    },
    "faq.nutrition.q1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How are my macro targets calculated?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment mes cibles de macros sont-elles calculées ?"
          }
        }
      }
    },
    "faq.nutrition.q2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does the AI analysis sometimes look wrong?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi l’analyse IA semble-t-elle parfois fausse ?"
          }
        }
      }
    },
    "faq.nutrition.q3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does the nutrition score mean?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que signifie le score nutritionnel ?"
          }
        }
      }
    },
    "faq.nutrition.q4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far back can I see my food history?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’où puis-je remonter dans mon historique ?"
          }
        }
      }
    },
    "faq.nutrition.title": {
      "localizations": {
        "en": {
