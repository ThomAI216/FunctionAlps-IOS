    "nutrient.iron.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iron forms haemoglobin to carry oxygen through the body. Iron deficiency is the world's most common nutritional deficiency · women are particularly at risk. Heme iron (meat) absorbs 2-3x better than non-heme (plants)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fer contribue à la formation de l'hémoglobine, qui assure le transport de l'oxygène dans l'organisme. La carence en fer est la carence nutritionnelle la plus répandue au monde ; les femmes sont particulièrement exposées à ce risque. Le fer héminique (provenant de la viande) est absorbé 2 à 3 fois mieux que le fer non héminique (provenant des végétaux)."
          }
        }
      }
    },
