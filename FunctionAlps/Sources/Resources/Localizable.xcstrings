    "nutrient.folate.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folate is essential for DNA replication, cell division, amino acid metabolism, and methylation reactions. Critical during pregnancy and for anyone with MTHFR variants."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le folate est essentiel à la réplication de l'ADN, à la division cellulaire, au métabolisme des acides aminés et aux réactions de méthylation. Il revêt une importance cruciale pendant la grossesse et pour toute personne présentant des variants du gène MTHFR."
          }
        }
      }
    },
