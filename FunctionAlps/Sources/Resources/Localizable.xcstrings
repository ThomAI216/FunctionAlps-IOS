      }
    },
    "nutrientGroup.fatty_acids.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polyunsaturated fats that the body cannot produce on its own. Omega-3 (anti-inflammatory) and Omega-6 (pro-inflammatory) must be consumed in the right ratio · ideally 1:4 or less."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les acides gras polyinsaturés que l'organisme ne peut pas produire lui-même. Les oméga-3 (anti-inflammatoires) et les oméga-6 (pro-inflammatoires) doivent être consommés dans un rapport équilibré · idéalement de 1 pour 4, voire moins."
          }
        }
      }
    },
    "nutrientGroup.fatty_acids.foods": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatty fish (salmon, sardines, mackerel), walnuts, flaxseeds, chia seeds"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poissons gras (saumon, sardines, maquereau), noix, graines de lin, graines de chia"
          }
        }
      }
    },
    "nutrientGroup.fatty_acids.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Essential Fatty Acids"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acides gras essentiels"
          }
        }
      }
    },
    "nutrientGroup.fatty_acids.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern diets often skew 1:20 or worse Omega-3:Omega-6. This chronic imbalance drives systemic inflammation, poor cardiovascular health, brain fog, and mood instability."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les régimes alimentaires modernes présentent souvent un rapport oméga-3/oméga-6 de 1 pour 20, voire pire. Ce déséquilibre chronique est à l'origine d'une inflammation systémique, de problèmes de santé cardiovasculaire, d'un manque de clarté mentale et d'instabilité de l'humeur."
          }
        }
      }
    },
    "nutrientGroup.minerals.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inorganic elements required for bone structure, nerve transmission, fluid balance, enzyme function, and oxygen transport. Unlike vitamins, they cannot be created or broken down."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments inorganiques indispensables à la structure osseuse, à la transmission nerveuse, à l'équilibre hydrique, au fonctionnement des enzymes et au transport de l'oxygène. Contrairement aux vitamines, ils ne peuvent être ni synthétisés ni dégradés."
          }
        }
      }
    },
    "nutrientGroup.minerals.foods": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuts, seeds, legumes, leafy greens, seafood, dairy, whole grains"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noix, graines, légumineuses, légumes verts à feuilles, fruits de mer, produits laitiers, céréales complètes"
          }
        }
      }
    },
    "nutrientGroup.minerals.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minerals"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minéraux"
          }
        }
      }
    },
    "nutrientGroup.minerals.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mineral deficiencies are among the most common nutritional issues in modern diets. Magnesium alone is involved in 300+ enzymatic reactions · low levels are linked to fatigue, muscle cramps, anxiety, and poor sleep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les carences en oligo-éléments comptent parmi les problèmes nutritionnels les plus courants dans l'alimentation moderne. À lui seul, le magnésium intervient dans plus de 300 réactions enzymatiques ; des taux insuffisants sont associés à la fatigue, aux crampes musculaires, à l'anxiété et à des troubles du sommeil."
          }
        }
      }
    },
    "nutrientGroup.vitamins.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organic compounds essential for growth, energy metabolism, immune function, and cellular repair. Most cannot be synthesised by the body · they must come from food."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Composés organiques indispensables à la croissance, au métabolisme énergétique, au fonctionnement du système immunitaire et à la réparation cellulaire. La plupart ne peuvent pas être synthétisés par l'organisme : ils doivent provenir de l'alimentation."
          }
        }
      }
    },
    "nutrientGroup.vitamins.foods": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leafy greens, organ meats, fish, eggs, citrus, fortified foods, sunlight (D3)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Légumes verts à feuilles, abats, poisson, œufs, agrumes, aliments enrichis, exposition au soleil (vitamine D3)"
          }
        }
      }
    },
    "nutrientGroup.vitamins.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamins"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamines"
          }
        }
      }
    },
    "nutrientGroup.vitamins.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamins act as cofactors in hundreds of enzymatic reactions. Even subclinical deficiencies can cause fatigue, poor immunity, skin issues, and neurological symptoms long before clinical signs appear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vitamines jouent le rôle de cofacteurs dans des centaines de réactions enzymatiques. Même des carences subcliniques peuvent entraîner de la fatigue, une baisse des défenses immunitaires, des problèmes cutanés et des symptômes neurologiques bien avant l'apparition de signes cliniques."
          }
        }
      }
    },
