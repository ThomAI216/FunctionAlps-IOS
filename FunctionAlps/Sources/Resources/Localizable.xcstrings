    "targets.warn.build.aggressive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Aggressive surplus. Higher fat gain likely. Consult your nutritionist before going this high."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Surplus agressif. Prise de gras probable. Consultez votre nutritionniste avant d’aller aussi haut."
          }
        }
      }
    },
    "targets.warn.build.lean": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean bulk · minimal fat gain, steady muscle progress."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise de masse propre · peu de gras, progrès musculaire régulier."
          }
        }
      }
    },
    "targets.warn.build.standard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard bulk · good for muscle building."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise de masse standard · efficace pour construire du muscle."
          }
        }
      }
    },
    "targets.warn.cut.aggressive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Aggressive deficit. Risk of muscle loss. Don’t go beyond this without talking to your nutritionist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Déficit agressif. Risque de perte musculaire. N’allez pas au-delà sans en parler à votre nutritionniste."
          }
        }
      }
    },
    "targets.warn.cut.mild": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mild deficit · sustainable, minimal muscle risk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déficit léger · durable, risque musculaire minime."
          }
        }
      }
    },
    "targets.warn.cut.moderate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderate deficit · effective for most people."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déficit modéré · efficace pour la plupart des gens."
          }
        }
      }
    },
    "tip.am_hydrate.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink a glass of water before your coffee today and watch the fog lift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez un verre d'eau avant votre café aujourd'hui et regardez le brouillard se dissiper."
          }
        }
      }
    },
    "tip.am_hydrate.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water before coffee · much of morning fog is just mild dehydration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l'eau avant le café · une grande partie de la fatigue matinale n'est qu'une légère déshydratation."
          }
        }
      }
    },
    "tip.am_light.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get 5 minutes of morning light today and fall asleep easier tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez dès aujourd’hui de 5 minutes de lumière matinale et vous vous endormirez plus facilement ce soir."
          }
        }
      }
    },
    "tip.am_light.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step into daylight within an hour of waking · it anchors your energy today and your sleep tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposez-vous à la lumière du jour dans l'heure qui suit votre réveil : cela vous aidera à trouver votre équilibre énergétique aujourd'hui et à bien dormir cette nuit."
          }
        }
      }
    },
    "tip.am_mind.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make breakfast protein-first today and notice steadier focus all morning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui, privilégiez les protéines au petit-déjeuner et constatez que votre concentration reste plus stable tout au long de la matinée."
          }
        }
      }
    },
    "tip.am_mind.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A protein breakfast steadies mood and focus · the brain runs poorly on sugar swings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit-déjeuner riche en protéines stabilise l'humeur et favorise la concentration · le cerveau fonctionne mal en cas de fluctuations glycémiques."
          }
        }
      }
    },
    "tip.am_protein.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add eggs, yoghurt or a protein shake tomorrow morning and feel the afternoon dip fade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demain matin, ajoutez des œufs, du yaourt ou une boisson protéinée à votre petit-déjeuner et vous verrez le coup de barre de l'après-midi s'estomper."
          }
        }
      }
    },
    "tip.am_protein.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front-load protein at breakfast · it steadies energy and curbs afternoon cravings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consommez des protéines dès le petit-déjeuner : cela vous permet de maintenir un niveau d'énergie constant et de limiter les fringales de l'après-midi."
          }
        }
      }
    },
