    "nutrient.vitamin_c.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Essential for collagen synthesis, iron absorption, immune defence, and neutralising free radicals. The body excretes excess daily, so consistent intake is needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indispensable à la synthèse du collagène, à l'absorption du fer, aux défenses immunitaires et à la neutralisation des radicaux libres. L'organisme élimine quotidiennement l'excès de fer ; un apport régulier est donc nécessaire."
          }
        }
      }
    },
