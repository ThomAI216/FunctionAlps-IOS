    "nutrient.vitamin_d3.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin D3 functions as a hormone, regulating calcium absorption, immune function, mood, and gene expression. Up to 80% of European adults are deficient, especially in winter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitamine D3 agit comme une hormone : elle régule l'absorption du calcium, la fonction immunitaire, l'humeur et l'expression génétique. Jusqu'à 80 % des adultes européens présentent une carence, notamment en hiver."
          }
        }
      }
    },
