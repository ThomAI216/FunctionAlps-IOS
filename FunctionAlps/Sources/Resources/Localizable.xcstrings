    "nutrient.vitamin_b12.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical for red blood cell formation, DNA synthesis, and nervous system function. Vegans and vegetarians are at high risk of deficiency. Absorption declines with age."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essentiel à la formation des globules rouges, à la synthèse de l'ADN et au bon fonctionnement du système nerveux. Les végétaliens et les végétariens courent un risque élevé de carence. Son absorption diminue avec l'âge."
          }
        }
      }
    },
