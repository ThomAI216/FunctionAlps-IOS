    "nutrient.vitamin_e.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin E is a fat-soluble antioxidant that protects cell membranes from oxidative damage. It supports immune function, skin health, and cardiovascular protection. Works synergistically with Vitamin C."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitamine E est un antioxydant liposoluble qui protège les membranes cellulaires contre les dommages oxydatifs. Elle contribue au bon fonctionnement du système immunitaire, à la santé de la peau et à la protection cardiovasculaire. Elle agit en synergie avec la vitamine C."
          }
        }
      }
    },
