    "wearables.apple.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Watch already writes into Apple Health on this iPhone. Allow FunctionAlps to read it and your nights, steps and heart data arrive on their own, including while the app is closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple Watch écrit déjà dans Apple Santé sur cet iPhone. Autorisez FunctionAlps à le lire et vos nuits, vos pas et vos données cardiaques arrivent d’eux-mêmes, même lorsque l’application est fermée."
          }
        }
      }
    },
    "wearables.apple.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health & Apple Watch"
          }
        },
