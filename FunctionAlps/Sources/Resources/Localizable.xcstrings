    "trends.soon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Functional Score, pillars and 14-day trends arrive here once the scoring engine moves to the server — the same numbers on every device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Score Fonctionnel, vos piliers et vos tendances sur 14 jours arriveront ici dès que le moteur de calcul passera côté serveur — les mêmes chiffres sur tous vos appareils."
          }
        }
      }
    },
