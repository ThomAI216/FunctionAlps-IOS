    "wearables.read.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only. Nothing is written back to Health, and you can turn any type off in Settings → Health → Data Access & Devices → FunctionAlps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule. Rien n’est écrit dans Santé, et vous pouvez désactiver chaque type dans Réglages → Santé → Accès aux données et appareils → FunctionAlps."
          }
        }
      }
    },
