    "nutrient.choline.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choline is required for cell membrane structure (phosphatidylcholine), neurotransmitter synthesis (acetylcholine), methyl donation, and liver fat metabolism. Over 90% of people do not meet the adequate intake."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La choline est indispensable à la structure des membranes cellulaires (phosphatidylcholine), à la synthèse des neurotransmetteurs (acétylcholine), au transfert de groupes méthyles et au métabolisme des graisses hépatiques. Plus de 90 % de la population n'atteint pas l'apport recommandé."
          }
        }
      }
    },
