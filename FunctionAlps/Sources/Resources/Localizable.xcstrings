    "macroEdu.carbs.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your brain and muscles run on this"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ce qui alimente votre cerveau et vos muscles"
          }
        }
      }
    },
    "macroEdu.carbs.timing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritise carbs around workouts. Reduce simple sugars in the evening. Keep fiber high throughout the day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégiez les glucides aux moments des séances d'entraînement. Limitez votre consommation de sucres simples le soir. Veillez à avoir un apport élevé en fibres tout au long de la journée."
          }
        }
      }
    },
    "macroEdu.carbs.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbohydrates"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucides"
          }
        }
      }
    },
    "macroEdu.carbs.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbohydrates are your primary energy source. Your brain alone uses 120g per day. Quality matters more than quantity - choose complex carbs with fiber over refined sugars."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les glucides constituent votre principale source d'énergie. À lui seul, votre cerveau en consomme 120 g par jour. La qualité prime sur la quantité : privilégiez les glucides complexes riches en fibres plutôt que les sucres raffinés."
          }
        }
      }
    },
    "macroEdu.fat.myth.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Myth: Fat makes you fat (excess calories do)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mythe : les graisses font grossir (c'est l'excès de calories qui en est la cause)"
          }
        }
      }
    },
    "macroEdu.fat.myth.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Myth: All saturated fat is bad (coconut and dairy fat behave differently)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mythe : toutes les graisses saturées sont mauvaises pour la santé (les graisses de coco et les matières grasses laitières se comportent différemment)"
          }
        }
      }
    },
