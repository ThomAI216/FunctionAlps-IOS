    "consents.accepted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepté"
          }
        }
      }
    },
    "consents.confirm.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing your health data is what FunctionAlps is, so withdrawing switches the app off until you give it again. That is a consequence, not a penalty.\n\nYour data is not deleted by withdrawing. You can consent again and pick up where you left off, or delete your account to erase everything. If you want a copy first, export your data before you do either."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement de vos données de santé est ce en quoi consiste FunctionAlps : le retrait désactive donc l’application jusqu’à ce que vous consentiez à nouveau. C’est une conséquence, et non une sanction.\n\nLe retrait ne supprime pas vos données. Vous pouvez consentir à nouveau et reprendre où vous en étiez, ou supprimer votre compte pour tout effacer. Si vous souhaitez une copie, exportez vos données au préalable."
          }
        }
      }
    },
    "consents.confirm.cta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw and disable the app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer et désactiver l’application"
          }
        }
      }
    },
    "consents.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw this consent?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer ce consentement ?"
          }
        }
      }
    },
    "consents.core": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required to use the app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requis pour utiliser l’application"
          }
        }
      }
    },
    "consents.empty.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These documents are still with our lawyers, so nothing has been recorded against your account. This page will list your consents once they are live."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces documents sont encore chez nos juristes : rien n’a donc été enregistré pour votre compte. Cette page listera vos consentements dès qu’ils seront en vigueur."
          }
        }
      }
    },
    "consents.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to manage yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à gérer pour l’instant"
          }
        }
      }
    },
    "consents.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every change is recorded with the date and the exact wording in force, so both of us can establish later what was agreed. Questions: data@functionalps.ch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modification est enregistrée avec sa date et le texte exact alors en vigueur, afin que chacun puisse établir ultérieurement ce qui a été convenu. Questions : data@functionalps.ch"
          }
        }
      }
    },
    "consents.grant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer"
          }
        }
      }
    },
    "consents.heading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your consents"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos consentements"
          }
        }
      }
    },
    "consents.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you agreed to, and what you can change. Turning something off takes effect immediately and never affects what was lawful while it was on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez accepté, et ce que vous pouvez modifier. Désactiver une option prend effet immédiatement et n’affecte jamais la licéité de ce qui a été fait auparavant."
          }
        }
      }
    },
    "consents.loadError": {
      "localizations": {
