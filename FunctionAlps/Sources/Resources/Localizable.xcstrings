    "nutrient.vitamin_a.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin A supports night vision, skin integrity, immune barriers, and cell differentiation. It exists as preformed (animal sources) and beta-carotene (plant sources)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitamine A contribue à la vision nocturne, à l'intégrité de la peau, au bon fonctionnement des barrières immunitaires et à la différenciation cellulaire. Elle se présente sous forme de vitamine A préformée (sources animales) et de bêta-carotène (sources végétales)."
          }
        }
      }
    },
