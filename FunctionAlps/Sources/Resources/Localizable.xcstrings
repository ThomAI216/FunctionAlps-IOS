    "activity.extremely.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I train intensely, sometimes more than once per day, or have a very physically demanding lifestyle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m’entraîne intensément, parfois plus d’une fois par jour, ou j’ai un mode de vie physiquement très exigeant."
          }
        }
      }
    },
    "activity.extremely.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highly active"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très sportif·ve"
          }
        }
      }
    },
    "activity.lightly.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I walk regularly or exercise around 1–2 times per week."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je marche régulièrement ou je fais de l’exercice 1 à 2 fois par semaine."
          }
        }
      }
    },
    "activity.lightly.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightly active"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Légèrement actif·ve"
          }
        }
      }
    },
    "activity.moderately.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I exercise around 3–4 times per week and/or have a reasonably active lifestyle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je fais de l’exercice 3 à 4 fois par semaine et/ou j’ai un mode de vie raisonnablement actif."
          }
        }
      }
    },
    "activity.moderately.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderately active"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modérément actif·ve"
          }
        }
      }
    },
    "activity.sedentary.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most of my day is seated, with little structured exercise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je passe l’essentiel de ma journée assis·e, avec peu d’exercice structuré."
          }
        }
      }
    },
    "activity.sedentary.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostly sedentary"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plutôt sédentaire"
          }
        }
      }
    },
    "activity.very.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I train most days or have a physically demanding lifestyle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m’entraîne presque tous les jours ou j’ai un mode de vie physiquement exigeant."
          }
        }
      }
    },
    "activity.very.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very active"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très actif·ve"
          }
        }
      }
    },
    "app.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading FunctionAlps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement de FunctionAlps"
          }
        }
      }
    },
    "auth.emailNotConfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please confirm your email address first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez d'abord confirmer votre adresse e-mail."
          }
        }
      }
    },
    "auth.rateLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait a moment and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Patientez un instant puis réessayez."
          }
        }
      }
    },
    "baseline.activity.edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your activity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier votre activité."
          }
        }
      }
    },
    "baseline.activity.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the one that sounds most like a normal week."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez celle qui ressemble le plus à une semaine normale."
          }
        }
      }
    },
    "baseline.activity.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the last piece of the estimate. Don’t overthink it · an ordinary week is the right answer, not your best one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la dernière pièce de l’estimation. Ne réfléchissez pas trop · une semaine ordinaire est la bonne réponse, pas votre meilleure."
          }
        }
      }
    },
    "baseline.age": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How old are you?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel âge avez-vous ?"
          }
        }
      }
    },
    "baseline.age.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an age between 16 and 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez un âge entre 16 et 100 ans."
          }
        }
      }
    },
    "baseline.edit.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your baseline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour votre point de départ."
          }
        }
      }
    },
    "baseline.energy.a11y": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %lld kilocalories per day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %lld kilocalories par jour"
          }
        }
      }
    },
    "baseline.energy.alongside": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "…alongside food quality, micronutrients, timing and meal composition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "…ainsi que la qualité des aliments, les micronutriments, le moment et la composition des repas."
          }
        }
      }
    },
    "baseline.energy.change": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your energy needs can also change over time depending on your activity, body composition and goals. This number gives us useful context for interpreting the rest of your nutrition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos besoins énergétiques peuvent aussi évoluer selon votre activité, votre composition corporelle et vos objectifs. Ce chiffre nous donne un contexte utile pour interpréter le reste de votre alimentation."
          }
        }
      }
    },
    "baseline.energy.compass": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your energy compass"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre boussole énergétique"
          }
        }
      }
    },
    "baseline.energy.eyebrow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your energy needs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos besoins énergétiques"
          }
        }
      }
    },
    "baseline.energy.made": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’re much more interested in what those calories are made of · and how you respond to them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui nous intéresse bien plus, c’est de quoi ces calories sont faites · et comment vous y réagissez."
          }
        }
      }
    },
    "baseline.energy.mostly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And most importantly: how you feel, and the reactions or symptoms you notice around your food."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et surtout : comment vous vous sentez, et les réactions ou symptômes que vous remarquez autour de vos repas."
          }
        }
      }
    },
    "baseline.energy.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your profile and activity level, this is our current estimate of how much energy your body uses in a typical day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après votre profil et votre niveau d’activité, voici notre estimation actuelle de l’énergie que votre corps utilise sur une journée type."
          }
        }
      }
    },
    "baseline.energy.p2a": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of it as a "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez-le comme une "
          }
        }
      }
    },
    "baseline.energy.p2b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "compass, not a score."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "boussole, pas un score."
          }
        }
      }
    },
    "baseline.energy.p2c": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don’t need to hit this number perfectly every day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas besoin d’atteindre ce chiffre exactement chaque jour."
          }
        }
      }
    },
    "baseline.energy.sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate of your typical daily energy needs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation de vos besoins énergétiques quotidiens habituels."
          }
        }
      }
    },
    "baseline.energy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your estimated daily energy target"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre objectif énergétique quotidien estimé"
          }
        }
      }
    },
    "baseline.energy.unit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kcal / day"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "kcal / jour"
          }
        }
      }
    },
    "baseline.female": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Female"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Femme"
          }
        }
      }
    },
    "baseline.height.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a height between 120 and 230 cm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez une taille entre 120 et 230 cm."
          }
        }
      }
    },
    "baseline.intro1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll start with a few basic measurements to estimate how much energy your body typically needs each day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous commençons par quelques mesures de base pour estimer l’énergie dont votre corps a habituellement besoin chaque jour."
          }
        }
      }
    },
    "baseline.intro2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This gives us useful context when looking at your meals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela nous donne un contexte utile pour regarder vos repas."
          }
        }
      }
    },
    "baseline.later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can update any of this later in your profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez modifier tout cela plus tard dans votre profil."
          }
        }
      }
    },
    "baseline.male": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Male"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homme"
          }
        }
      }
    },
    "baseline.saveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save that just now. Your answers are safe · try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu enregistrer pour l’instant. Vos réponses sont conservées · réessayez."
          }
        }
      }
    },
    "baseline.saving": {
      "localizations": {
