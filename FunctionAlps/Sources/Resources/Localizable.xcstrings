    "nutrient.selenium.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selenium is a component of powerful antioxidant enzymes and is essential for thyroid hormone synthesis and conversion (T4→T3). The EU population is often mildly deficient."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sélénium entre dans la composition d'enzymes antioxydantes puissantes et joue un rôle essentiel dans la synthèse et la conversion des hormones thyroïdiennes (T4 → T3). La population de l'Union européenne présente souvent une carence légère en sélénium."
          }
        }
      }
    },
