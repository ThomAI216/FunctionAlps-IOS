  "strings": {
    "access.beta.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your thirty days end on %@. Everything you record stays yours after that."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos trente jours se terminent le %@. Tout ce que vous enregistrez reste à vous ensuite."
          }
        }
      }
    },
    "access.beta.detail.noDate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you record stays yours after your thirty days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous enregistrez reste à vous après vos trente jours."
          }
        }
      }
    },
    "access.beta.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta access"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès bêta"
