    "nutrient.epa.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eicosapentaenoic acid (EPA) is the primary anti-inflammatory omega-3 fatty acid. It competes with arachidonic acid (omega-6) to reduce pro-inflammatory eicosanoid production. Found almost exclusively in marine sources."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acide eicosapentaénoïque (EPA) est le principal acide gras oméga-3 anti-inflammatoire. Il entre en compétition avec l'acide arachidonique (oméga-6) pour réduire la production d'eicosanoïdes pro-inflammatoires. On le trouve presque exclusivement dans les sources marines."
          }
        }
      }
    },
