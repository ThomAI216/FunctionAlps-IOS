    "nutrient.omega3.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EPA and DHA are the active forms of Omega-3 · found primarily in fatty fish. EPA reduces inflammation, DHA supports brain structure and function. Conversion from ALA (plant sources) is only 5-10% efficient."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'EPA et le DHA sont les formes actives des oméga-3, que l'on trouve principalement dans les poissons gras. L'EPA réduit l'inflammation, tandis que le DHA contribue au bon fonctionnement et à la structure du cerveau. Le taux de conversion à partir de l'ALA (sources végétales) n'est que de 5 à 10 %."
          }
        }
      }
    },
