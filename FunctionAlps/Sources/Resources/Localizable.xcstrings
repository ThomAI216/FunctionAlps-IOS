    "wearables.connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter Apple Santé"
          }
        }
      }
    },
    "wearables.connectFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health couldn't be opened. Check Settings → Health → Data Access & Devices and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Santé n’a pas pu être ouvert. Vérifiez Réglages → Santé → Accès aux données et appareils, puis réessayez."
          }
        }
      }
    },
    "wearables.connected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté"
          }
        }
      }
    },
    "wearables.connecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Apple Health…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture d’Apple Santé…"
          }
        }
      }
    },
    "wearables.disconnect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter"
          }
        }
      }
    },
    "wearables.disconnect.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone stops sending new readings. What was already synced stays in your record; to revoke Health access itself, use Settings → Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone cesse d’envoyer de nouvelles mesures. Ce qui a déjà été synchronisé reste dans votre dossier ; pour révoquer l’accès à Santé, passez par Réglages → Santé."
          }
        }
      }
    },
    "wearables.disconnect.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop syncing Apple Health?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la synchronisation d’Apple Santé ?"
          }
        }
      }
    },
    "wearables.gated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting opens as soon as the updated Privacy Notice, which describes this data, is published. Nothing is read until then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion s’ouvrira dès la publication de la Déclaration de confidentialité mise à jour, qui décrit ces données. Rien n’est lu d’ici là."
          }
        }
      }
    },
    "wearables.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a wearable to bring your steps, sleep, heart rate and recovery into FunctionAlps automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un objet connecté pour amener automatiquement vos pas, votre sommeil, votre fréquence cardiaque et votre récupération dans FunctionAlps."
          }
        }
      }
    },
    "wearables.lastSync": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected · synced %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté · synchronisé %@"
          }
        }
