          }
        }
      }
    },
    "help.search": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search questions..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher une question..."
          }
        }
      }
    },
    "help.stillNeed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still need help?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore besoin d’aide ?"
          }
        }
      }
    },
    "help.stillNeed.sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a message to your nutritionist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un message à votre nutritionniste"
          }
        }
      }
    },
    "help.trends.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you log · your check-ins, your meals · rolls up into one score. It is here so you can see whether things are moving in the right direction without having to read charts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous enregistrez · vos bilans, vos repas · se résume en un score. Il est là pour voir si les choses vont dans le bon sens sans lire de graphiques."
          }
        }
      }
    },
    "help.trends.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "your progress, in one number"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vos progrès, en un chiffre"
          }
        }
      }
    },
    "help.trends.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any of the three parts to see exactly what moved it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’une des trois parties pour voir exactement ce qui l’a fait bouger."
          }
        }
      }
    },
    "help.trends.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you log, rolled into one score · your own check-ins first, your device second."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous enregistrez, regroupé en un score · vos propres bilans d’abord, votre appareil ensuite."
          }
        }
      }
    },
    "help.trends.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You see direction, not noise. A low day is information, not a failure · and your practitioner sees this same view."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez une direction, pas du bruit. Un jour bas est une information, pas un échec · et votre praticienne voit la même vue."
          }
        }
      }
    },
    "help.trends.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendances"
          }
        }
      }
    },
    "help.why.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the least impressive-looking part of the app, and it is the part that makes everything else about you. On day one the app only knows what was on your intake form · it can be helpful, but it is being helpful in general. After two weeks of check-ins and meals it knows your afternoons dip, that bread sits badly with you, that you sleep better on days you walk. Now it is being helpful about you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la partie la moins impressionnante de l’application, et c’est celle qui rend tout le reste à votre image. Le premier jour, l’application ne connaît que votre formulaire d’accueil · elle peut aider, mais en général. Après deux semaines de bilans et de repas, elle sait que vos après-midi creusent, que le pain passe mal, que vous dormez mieux les jours où vous marchez. Là, elle vous aide vous."
          }
        }
      }
    },
    "help.why.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more of your ordinary days it sees, the more the advice fits your life rather than an average one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus elle voit vos journées ordinaires, plus les conseils collent à votre vie plutôt qu’à une moyenne."
          }
        }
      }
    },
    "help.why.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "thirty seconds a day, and what it buys you"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "trente secondes par jour, et ce que cela vous apporte"
          }
        }
      }
    },
    "help.why.p1.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is wasted"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est perdu"
          }
        }
      }
    },
    "help.why.p1.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every check-in, every meal, every \"that one felt rough\" makes the next thing you see sharper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque bilan, chaque repas, chaque « celui-là est mal passé » rend la suite plus précise."
          }
        }
      }
    },
    "help.why.p2.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An off day helps too"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour sans aide aussi"
          }
        }
      }
    },
    "help.why.p2.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rough week is not a hole in your record. It is often the most useful week in it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine difficile n’est pas un trou dans votre carnet. C’est souvent la plus utile."
          }
        }
      }
    },
    "help.why.p3.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your practitioner reads it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre praticienne le lit"
          }
        }
      }
    },
    "help.why.p3.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They come to your call already knowing how your month went, so you can spend the call on what to do next."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle arrive à votre consultation en sachant déjà comment s’est passé votre mois, et vous pouvez consacrer le temps à la suite."
          }
        }
      }
    },
    "help.why.p4.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are allowed to be quick"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez le droit d’aller vite"
          }
        }
      }
    },
    "help.why.p4.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rough and honest beats precise and skipped. A slider roughly in the right place is plenty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximatif et honnête vaut mieux que précis et sauté. Un curseur à peu près au bon endroit suffit largement."
          }
        }
      }
    },
    "help.why.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the small stuff you type matters"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi les petites choses que vous notez comptent"
          }
        }
      }
    },
