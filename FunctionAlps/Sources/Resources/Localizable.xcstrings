    "nutrient.phosphorus.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phosphorus is the second most abundant mineral in the body. It forms the backbone of DNA and ATP (cellular energy), builds bones alongside calcium, and buffers blood pH. Deficiency is rare but can occur with excessive antacid use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le phosphore est le deuxième minéral le plus abondant dans l'organisme. Il constitue la structure fondamentale de l'ADN et de l'ATP (énergie cellulaire), participe à la formation des os aux côtés du calcium et joue un rôle de tampon dans le pH sanguin. Une carence est rare, mais peut survenir en cas d'utilisation excessive d'antiacides."
          }
        }
      }
    },
