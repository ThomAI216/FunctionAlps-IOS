    "nutrient.vitamin_k2.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K2 activates proteins that direct calcium to bones (not arteries). Often deficient in Western diets. Works synergistically with D3 · both are needed together."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La K2 active les protéines qui acheminent le calcium vers les os (et non vers les artères). Elle fait souvent défaut dans l'alimentation occidentale. Elle agit en synergie avec la vitamine D3 : ces deux éléments sont indispensables l'un sans l'autre."
          }
        }
      }
    },
