    "access.discovery.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask for full access whenever you are ready and we will take it from there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez l’accès complet quand vous êtes prêt·e et nous prenons le relais."
