    "nutrient.iodine.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Iodine is required for thyroid hormone production (T3 and T4), which controls metabolism, temperature, heart rate, and energy. Deficiency is a leading cause of hypothyroidism."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'iode est indispensable à la production des hormones thyroïdiennes (T3 et T4), qui régulent le métabolisme, la température corporelle, la fréquence cardiaque et l'énergie. Une carence en iode est l'une des principales causes de l'hypothyroïdie."
          }
        }
      }
    },
